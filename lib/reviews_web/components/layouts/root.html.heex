<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, interactive-widget=resizes-content"
    />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="color-scheme" content="light dark" />
    <meta name="diffs-worker" content={~p"/assets/js/diffs_worker.js"} />
    <meta name="theme-color" content="#fafafa" />
    <meta name="theme-color" content="#19232f" media="(prefers-color-scheme: dark)" />
    <.live_title default="Reviews" phx-no-format>{assigns[:page_title]}</.live_title>
    <.link_preview_tags preview={assigns[:link_preview]} />
    <script phx-track-static src={~p"/assets/js/theme.js"}>
    </script>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only fixed top-2 left-2 z-50 bg-base-100 border px-3 py-1 rounded"
    >
      Skip to main content
    </a>
    <main id="main" tabindex="-1">
      {@inner_content}
    </main>
  </body>
</html>
