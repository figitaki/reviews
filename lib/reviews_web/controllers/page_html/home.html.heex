<Layouts.app flash={@flash} chrome={false}>
  <main id="reviews-home" class="design-page">
    <.ds_shell brand="Reviews" home={~p"/"}>
      <:nav>
        <.ds_nav_item navigate={~p"/"} active>Home</.ds_nav_item>
        <.ds_nav_item navigate={~p"/r/demo-review"}>Demo Review</.ds_nav_item>
        <.ds_nav_item navigate={~p"/settings"}>Settings</.ds_nav_item>
      </:nav>
      <:actions>
        <Layouts.theme_toggle />
      </:actions>

      <div class="design-main">
        <.ds_page_header
          eyebrow="0.0.1-alpha.0"
          title="Reviews Turns Any Git Diff Into A Shareable Review."
          description="Install the CLI, push a branch, and get a review URL with patchsets, review packets, and draft comments kept together for humans and agents."
        >
          <:actions>
            <.link navigate={~p"/r/demo-review"} class="ds-button is-primary">
              <.icon name="hero-code-bracket-square" class="size-4" /> Open Demo Review
            </.link>
            <.link navigate={~p"/settings"} class="ds-button">
              <.icon name="hero-cog-6-tooth" class="size-4" /> Configure Settings
            </.link>
          </:actions>
        </.ds_page_header>

        <.ds_section
          id="install"
          eyebrow="Distribution"
          title="One Command Installs The Alpha CLI."
          description="Reviews starts from your terminal. The CLI uploads the current branch to the hosted service or your local Phoenix server."
        >
          <div class="grid gap-4 lg:grid-cols-[minmax(0,1.1fr)_minmax(18rem,0.9fr)]">
            <.ds_card class="min-w-0">
              <div class="space-y-4">
                <div>
                  <h3>Install, Login, Push</h3>
                  <p>
                    The alpha release is versioned as v0.0.1-alpha.0 so we can ship the
                    distribution path before claiming API stability.
                  </p>
                </div>
                <div
                  class="rounded-lg border border-white/10 bg-black/30 p-4 font-mono text-sm leading-7 text-white/80"
                  translate="no"
                >
                  <div>
                    $ curl -fsSL https://raw.githubusercontent.com/figitaki/reviews/main/install.sh | sh
                  </div>
                  <div>$ reviews login</div>
                  <div>$ reviews push --title "Review this change"</div>
                </div>
              </div>
            </.ds_card>

            <.ds_card>
              <div class="flex items-start gap-3">
                <span class="rounded-lg border border-white/10 bg-white/5 p-2 text-white/80">
                  <.icon name="hero-key" class="size-5" />
                </span>
                <div>
                  <h3>Hosted Or Local</h3>
                  <p>
                    Point `reviews login` at the hosted alpha or at `http://localhost:4000`
                    when you are running Reviews yourself.
                  </p>
                </div>
              </div>
            </.ds_card>
          </div>
        </.ds_section>

        <.ds_section
          id="review-workflow"
          eyebrow="Review Workflow"
          title="Patchsets Stay Reviewable As The Diff Moves."
          description="Each update becomes a patchset, while discussions stay anchored to the changed code instead of a fragile line number."
        >
          <div class="grid gap-4 md:grid-cols-3">
            <.ds_card>
              <div class="flex items-start gap-3">
                <span class="rounded-lg border border-white/10 bg-white/5 p-2 text-white/80">
                  <.icon name="hero-document-magnifying-glass" class="size-5" />
                </span>
                <div>
                  <h3>Inspect Diffs</h3>
                  <p>
                    Browse file changes, hunk context, and line-level discussion in a focused,
                    code-first workspace.
                  </p>
                </div>
              </div>
            </.ds_card>

            <.ds_card>
              <div class="flex items-start gap-3">
                <span class="rounded-lg border border-white/10 bg-white/5 p-2 text-white/80">
                  <.icon name="hero-chat-bubble-left-right" class="size-5" />
                </span>
                <div>
                  <h3>Draft Comments</h3>
                  <p>
                    Keep reviewer notes private until the batch is ready, then publish the review
                    as one coherent pass.
                  </p>
                </div>
              </div>
            </.ds_card>

            <.ds_card>
              <div class="flex items-start gap-3">
                <span class="rounded-lg border border-white/10 bg-white/5 p-2 text-white/80">
                  <.icon name="hero-arrows-right-left" class="size-5" />
                </span>
                <div>
                  <h3>Carry Context</h3>
                  <p>
                    Thread anchors use surrounding code so comments can survive rebases,
                    amendments, and regenerated patches.
                  </p>
                </div>
              </div>
            </.ds_card>
          </div>
        </.ds_section>

        <.ds_section
          id="cli-workflow"
          eyebrow="Agent Handoff"
          title="End A Coding Session With A Review Prompt."
          description="Reviews gives Codex and teammates the same artifact: a URL with the diff, packet context, patchset history, and comment surface."
        >
          <div class="grid gap-4 lg:grid-cols-[minmax(0,1.1fr)_minmax(18rem,0.9fr)]">
            <.ds_card class="min-w-0">
              <div class="space-y-4">
                <div>
                  <h3>Prompt For The Next Pass</h3>
                  <p>
                    Drop this at the end of a session that already has the Reviews skills loaded.
                  </p>
                </div>
                <div
                  class="rounded-lg border border-white/10 bg-black/30 p-4 font-mono text-sm leading-7 text-white/80"
                  translate="no"
                >
                  <div>Use the Reviews skills already loaded in this session.</div>
                  <div>
                    Push the current branch, open the review URL, inspect the diff and packet,
                  </div>
                  <div>
                    leave draft comments, then publish the review when the pass is complete.
                  </div>
                </div>
              </div>
            </.ds_card>

            <.ds_card>
              <h3>Built For Follow-Up Patchsets</h3>
              <p>
                Generated code, hand-written fixes, and follow-up edits all land in the same review
                history through <code translate="no">reviews push --update &lt;slug&gt;</code>.
              </p>
              <div class="mt-5 flex flex-wrap gap-2 text-sm">
                <span class="rounded-full border border-white/10 px-3 py-1" translate="no">
                  CLI
                </span>
                <span class="rounded-full border border-white/10 px-3 py-1" translate="no">
                  API
                </span>
                <span class="rounded-full border border-white/10 px-3 py-1">Patchsets</span>
                <span class="rounded-full border border-white/10 px-3 py-1">Comments</span>
              </div>
            </.ds_card>
          </div>
        </.ds_section>

        <.ds_section
          id="system-direction"
          eyebrow="Release Cadence"
          title="Changelog First, Releases Next."
          description="The first alpha establishes the version baseline, install story, and release notes before regular tagged releases start flowing."
        >
          <div class="grid gap-4 md:grid-cols-2">
            <.ds_card>
              <h3>Alpha Baseline</h3>
              <p>
                Version `0.0.1-alpha.0` marks the CLI, hosted app, OAuth token flow, patchsets, and
                review packets as the first public baseline.
              </p>
            </.ds_card>

            <.ds_card>
              <h3>Release Notes Stay Close</h3>
              <p>
                `CHANGELOG.md` now tracks what ships, what is deferred, and what should be called
                out when the next tag is cut.
              </p>
            </.ds_card>
          </div>
        </.ds_section>
      </div>
    </.ds_shell>
  </main>
</Layouts.app>
