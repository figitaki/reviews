# Register an OAuth app at https://github.com/settings/developers
# Callback URL: http://localhost:4000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: point dev/test at a Postgres running on a non-default port.
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_USER=reviews
POSTGRES_PASSWORD=

# Optional: code storage (code.storage backend). Off unless the adapter is set.
# CODE_STORAGE_ADAPTER=code_storage
# CODE_STORAGE_ORG=
# CODE_STORAGE_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# CODE_STORAGE_POLICY=optional
