# Register an OAuth app at https://github.com/settings/developers
# Callback URL: http://localhost:4000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: point dev/test at a Postgres running on a non-default port.
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_USER=reviews
POSTGRES_PASSWORD=

# Optional: code storage (code.storage backend). Off unless the adapter is set.
# CODE_STORAGE_ADAPTER=code_storage
# CODE_STORAGE_ORG=
# Unencrypted PKCS8, named-curve P-256 (not explicit EC parameters).
# CODE_STORAGE_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# CODE_STORAGE_POLICY=optional

# Optional: Privacy Policy and Terms of Service (docs/LEGAL_PAGES.md). Unset
# means no legal pages or links. Link your own, or fill in a built-in template.
# LEGAL_PRIVACY_URL=
# LEGAL_TERMS_URL=
# LEGAL_OPERATOR_NAME=
# LEGAL_CONTACT_EMAIL=
# LEGAL_UPDATED=
# LEGAL_HOSTING_REGION=
# LEGAL_LOG_RETENTION=
# LEGAL_BACKUP_RETENTION=
# LEGAL_GOVERNING_LAW=
# LEGAL_VENUE=
# LEGAL_LIABILITY_CAP=
